# Lấy từ https://developers.facebook.com/apps -> App của bạn -> Settings -> Basic
FB_APP_ID=
FB_APP_SECRET=

# Page Access Token (chạy: python fb_poster.py token --user-token <TOKEN> để lấy)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Phiên bản Graph API
FB_GRAPH_VERSION=v23.0

# Trợ lý AI (chọn nhà cung cấp trong Cài đặt -> Trợ lý AI; có thể nhập key ở đó thay vì đặt ở đây)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
